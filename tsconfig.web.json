{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "useDefineForClassFields": true,
    "baseUrl": ".",
    "paths": { "@core/*": ["src/core/*"], "@/*": ["src/renderer/src/*"] },
    "composite": true
  },
  "include": ["src/core/**/*", "src/renderer/src/**/*", "src/preload/*.d.ts"]
}
